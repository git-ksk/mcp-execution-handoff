+private func emitHostExitReason(_ reason: WebRtcHostExitReason) {
+    FileHandle.standardError.write(Data("MCP_HANDOFF_DIAGNOSTIC host_exit_reason=\(reason.rawValue)\n".utf8))
+}
 
