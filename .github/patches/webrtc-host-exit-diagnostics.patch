+private enum WebRtcHostExitReason: String {
+    case stdinEOF = "stdin_eof"
+    case permission
+    case windowResolution = "window_resolution"
+    case captureStart = "capture_start"
+    case encoder
+    case leaseExpiry = "lease_expiry"
