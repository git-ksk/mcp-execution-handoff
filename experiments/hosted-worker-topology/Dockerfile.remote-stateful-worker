FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates chromium \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev
COPY experiments/hosted-worker-topology/managed-remote-browser-worker.mjs ./experiments/hosted-worker-topology/managed-remote-browser-worker.mjs

ENV NODE_ENV=production
CMD ["node", "experiments/hosted-worker-topology/managed-remote-browser-worker.mjs"]
