FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev
COPY experiments/hosted-worker-topology/managed-control-plane.mjs ./experiments/hosted-worker-topology/managed-control-plane.mjs

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["node", "experiments/hosted-worker-topology/managed-control-plane.mjs"]
