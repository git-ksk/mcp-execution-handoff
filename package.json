{
  "name": "mcp-execution-handoff",
  "version": "0.1.0",
  "private": true,
  "description": "Security-oriented execution handoff primitives for MCP workflows that require explicit human intervention.",
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./browser-takeover": "./dist/browser-takeover/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "README.ja.md", "SECURITY.md", "SECURITY.ja.md", "CONTRIBUTING.md", "CONTRIBUTING.ja.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "keywords": ["mcp", "execution-handoff", "human-in-the-loop", "browser-takeover"],
  "repository": { "type": "git", "url": "git+https://github.com/git-ksk/mcp-execution-handoff.git" },
  "homepage": "https://github.com/git-ksk/mcp-execution-handoff#readme",
  "bugs": { "url": "https://github.com/git-ksk/mcp-execution-handoff/issues" },
  "license": "MIT"
}
